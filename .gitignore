# Build outputs
/build/
*.o
*.obj
*.exe
*.a

# Debug symbols that sanitizer builds (built with -debug) leave on macOS.
*.dSYM/

# Benchmark inputs: bench/gen.py writes the synthetic fixtures, bench/fetch.py the pinned corpus under corpus/.
/bench/fixtures/
# A peer built in place with cargo, without CARGO_TARGET_DIR.
/bench/peers/rust/target/
__pycache__/

# Logs, dumps and crash output.
*.log
*.out
*.bin
!/core/regex/tables/*.bin
*.dmp

# Editor and OS droppings
.DS_Store
*~
.#*
\#*\#
*.swp
*.swo

# Patch and merge leftovers
*.orig
*.rej

# Scratch temporaries.
*.tmp
*.temp
tmp/
