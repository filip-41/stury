# Build outputs
/build/
*.o
*.obj
*.exe
*.a

# Debug symbols that sanitizer builds (built with -debug) leave on macOS.
*.dSYM/

# Benchmark inputs: `bench fixtures` writes the synthetic ones and fetches the downloaded ones.
/bench/fixtures/
/bench/.venv/
# A driver built in place with cargo, without CARGO_TARGET_DIR.
/bench/target/
/bench/lanes/schema/rust/target/
__pycache__/

# Logs, dumps and crash output.
*.log
*.out
*.bin
!/core/regex/tables/*.bin
!/core/rules/tables/*.bin
!/core/spell/entities/*.bin
*.dmp

# Editor and OS droppings
.DS_Store
*~
.#*
\#*\#
*.swp
*.swo

# Patch and merge leftovers
*.orig
*.rej

# Scratch temporaries.
*.tmp
*.temp
tmp/
