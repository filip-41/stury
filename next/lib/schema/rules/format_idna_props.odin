@(private)
in_idna_prop :: proc "contextless" (prop: Idna_Prop, r: rune) -> bool {
	ranges: []u32
	switch prop {
	case .Greek:    ranges = PROP_GREEK[:]
	case .Hebrew:   ranges = PROP_HEBREW[:]
	case .Hiragana: ranges = PROP_HIRAGANA[:]
	case .Katakana: ranges = PROP_KATAKANA[:]
	case .Han:      ranges = PROP_HAN[:]
	case .Mark:     ranges = PROP_MARK[:]
	}
	if len(ranges) == 0 {
		return false
	}
	SPAN :: 1 << IDNA_RANGE_SPAN_BITS - 1
	key := u64(u32(r)) << IDNA_RANGE_SPAN_BITS | SPAN
	base := 0
	#no_bounds_check for n := len(ranges); n > 1; {
		half := n >> 1
		base = base + half if u64(ranges[base + half]) <= key else base
		n -= half
	}
	e := u64(ranges[base])
	return e <= key && u64(u32(r)) - e >> IDNA_RANGE_SPAN_BITS <= e & SPAN
}
