// Stores the lanes of `b` that `keep` marks, in order, at `out`, and returns how many there are. It stores up to 64
// bytes from `out`, so the caller keeps that room free. Each group of eight lanes is one table shuffle half and one
// 8-byte store, and one vector popcount counts all eight groups.
compress :: #force_inline proc "contextless" (b: Block, keep: u64, out: [^]u8) -> int #no_bounds_check {
	counts := transmute(u64)simd.count_ones(transmute(#simd[8]u8)keep)
	// Byte k of `running` is the number of lanes the groups below k keep, and byte 7 of `counts * ONES` is all of them.
	ONES :: 0x0101_0101_0101_0101
	running := (counts * ONES) << 8
	#unroll for k in 0 ..< 4 {
		shift := 16 * uint(k)
		lo := keep >> shift & 0xff
		hi := keep >> (shift + 8) & 0xff
		lanes := transmute(V)[2]u64{KEEP_LANES[lo], KEEP_LANES[hi] + 0x0808_0808_0808_0808}
		packed := transmute([2]u64)lookup(Tier(0), b[k], lanes)
		intrinsics.unaligned_store((^u64)(out[int(running >> shift & 0xff):]), packed[0])
		intrinsics.unaligned_store((^u64)(out[int(running >> (shift + 8) & 0xff):]), packed[1])
	}
	return int((counts * ONES) >> 56)
}
